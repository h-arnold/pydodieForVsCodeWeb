{
  "name": "pyodide-vscode-web",
  "displayName": "Pyodide Python Kernel for VS Code Web",
  "description": "Browser-based Python kernel for Jupyter notebooks powered by Pyodide",
  "version": "0.1.0",
  "publisher": "h-arnold",
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "python",
    "jupyter",
    "notebook",
    "pyodide",
    "web",
    "notebookKernelJupyterNotebook"
  ],
  "categories": [
    "Programming Languages",
    "Data Science",
    "Notebooks"
  ],
  "activationEvents": [
    "onNotebook:jupyter-notebook"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "notebookKernelProvider": [
      {
        "id": "pyodide-kernel",
        "viewType": "jupyter-notebook",
        "displayName": "Pyodide (Web)"
      }
    ],
    "commands": [
      {
        "command": "pyodide.restartKernel",
        "title": "Pyodide: Restart Kernel"
      },
      {
        "command": "pyodide.installPackage",
        "title": "Pyodide: Install Package"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package-web",
    "compile": "tsc -p ./",
    "compile-web": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package-web": "webpack --mode production",
    "lint": "eslint src test --ext ts",
    "lint:fix": "eslint src test --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "npm run compile && mocha",
    "test:coverage": "nyc npm test",
    "test:watch": "mocha --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || true",
    "security:audit": "npm audit --audit-level=moderate",
    "security:check": "snyk test || true"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.5",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-web": "^0.0.50",
    "buffer": "^6.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.0.2",
    "eslint-plugin-security": "^2.1.0",
    "husky": "^9.0.10",
    "lint-staged": "^15.2.0",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "path-browserify": "^1.0.1",
    "prettier": "^3.2.4",
    "process": "^0.11.10",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "pyodide": "^0.25.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "src/**/*.spec.ts"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "check-coverage": true,
    "lines": 80,
    "statements": 80,
    "functions": 80,
    "branches": 75
  }
}
